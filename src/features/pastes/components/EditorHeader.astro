---
import ButtonLink from "../../../components/ui/ButtonLink.astro";
import Divider from "../../../components/ui/Divider.astro";
---

<header class="flex flex-col gap-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="ui-label">
                Dopaste
            </p>
            <h1
                class="mt-2 font-semibold tracking-normal"
                style="color: var(--text-primary); font-size: var(--type-title);"
            >
                New Markdown Paste
            </h1>
        </div>
        <nav aria-label="Editor actions" class="flex items-center gap-2">
            <ButtonLink href="/" variant="ghost" class="px-3 py-2">
                New
            </ButtonLink>
        </nav>
    </div>
    <Divider />
</header>
