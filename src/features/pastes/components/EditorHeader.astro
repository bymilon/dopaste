---
import ButtonLink from "../../../components/ui/ButtonLink.astro";
import Divider from "../../../components/ui/Divider.astro";
---

<header class="flex flex-col gap-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-xl">
            <h1
                class="font-semibold tracking-normal"
                style="color: var(--text-primary); font-size: var(--type-title); line-height: 1.1;"
            >
                Dopaste
            </h1>
            <p class="mt-2 max-w-md text-sm leading-6" style="color: var(--text-secondary);">
                A quiet markdown editor for anonymous, permanent sharing.
            </p>
        </div>
        <nav aria-label="Editor actions" class="flex items-center gap-2">
            <ButtonLink href="/" variant="ghost" class="px-3 py-2">
                New
            </ButtonLink>
        </nav>
    </div>
    <Divider />
</header>
