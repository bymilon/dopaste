---
import Button from "../../../components/ui/Button.astro";
import FormField from "../../../components/ui/FormField.astro";
import Textarea from "../../../components/ui/Textarea.astro";

type Props = {
    error?: string;
    value?: string;
    disabled?: boolean;
};

const { error = "", value = "", disabled = false } = Astro.props;

const helperId = "paste-helper";
const errorId = "paste-error";
const describedBy = error ? `${helperId} ${errorId}` : helperId;
---

<form method="post" class="flex min-h-[28rem] flex-1 flex-col gap-4">
    <FormField label="Markdown" for="paste" meta="64 KiB max">
        <p id={helperId} class="sr-only">
            Paste markdown content up to 64 KiB.
        </p>
        <Textarea
            autofocus
            id="paste"
            name="paste"
            value={value}
            disabled={disabled}
            invalid={Boolean(error)}
            ariaDescribedby={describedBy}
            placeholder={`# Write your markdown here...

## Notes
- Fast anonymous sharing
- Permanent URL
- Rendered read view`}
        />
    </FormField>

    {
        error && (
            <p id={errorId} role="alert" class="text-sm" style="color: var(--danger);">
                {error}
            </p>
        )
    }

    <div class="flex justify-end">
        <Button type="submit" disabled={disabled}>
            Create Paste
        </Button>
    </div>
</form>
