---
type Props = {
    error?: string;
    value?: string;
    disabled?: boolean;
};

const { error = "", value = "", disabled = false } = Astro.props;
---

<form method="post" class="flex min-h-[28rem] flex-1 flex-col gap-4">
    <div class="flex items-center justify-between gap-3">
        <label
            for="paste"
            class="text-xs font-semibold uppercase tracking-[0.28em] text-zinc-500"
        >
            Markdown
        </label>
        <span class="text-xs text-zinc-600">64 KiB max</span>
    </div>

    <textarea
        autofocus
        id="paste"
        name="paste"
        aria-label="Create Markdown Paste"
        placeholder={`# Write your markdown here...

## Notes
- Fast anonymous sharing
- Permanent URL
- Rendered read view`}
        disabled={disabled}
        class="min-h-[24rem] flex-1 resize-y rounded border border-zinc-800 bg-zinc-950/80 px-4 py-4 font-mono text-sm leading-6 text-zinc-100 outline-none transition placeholder:text-zinc-700 focus:border-emerald-500/70 focus:ring-2 focus:ring-emerald-500/15 disabled:cursor-not-allowed disabled:opacity-50"
    >{value}</textarea>

    {error && <p class="text-sm text-rose-300">{error}</p>}

    <div class="flex justify-end">
        <button
            type="submit"
            disabled={disabled}
            class="rounded bg-emerald-400 px-4 py-2 text-sm font-semibold uppercase tracking-wide text-zinc-950 transition hover:bg-emerald-300 disabled:cursor-not-allowed disabled:bg-zinc-700 disabled:text-zinc-400"
        >
            Create Paste
        </button>
    </div>
</form>

