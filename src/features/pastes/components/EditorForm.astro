---
import Button from "../../../components/ui/Button.astro";
import FormField from "../../../components/ui/FormField.astro";
import Textarea from "../../../components/ui/Textarea.astro";

type Props = {
    error?: string;
    value?: string;
    disabled?: boolean;
};

const { error = "", value = "", disabled = false } = Astro.props;

const helperId = "paste-helper";
const errorId = "paste-error";
const describedBy = error ? `${helperId} ${errorId}` : helperId;
---

<form method="post" class="paste-form">
    <FormField label="Markdown" for="paste" class="paste-field flex flex-1">
        <p id={helperId} class="sr-only">
            Paste markdown content up to 64 KiB.
        </p>
        <Textarea
            autofocus
            id="paste"
            name="paste"
            value={value}
            disabled={disabled}
            invalid={Boolean(error)}
            ariaDescribedby={describedBy}
            class="paste-editor flex-1"
            placeholder=""
        />
    </FormField>

    {
        error && (
            <p id={errorId} role="alert" class="text-sm ui-error-message">
                {error}
            </p>
        )
    }

    <div class="paste-action-row">
        <Button
            type="submit"
            disabled={disabled}
            class="create-paste-button w-full px-5 py-4 sm:w-auto"
        >
            Create New Paste
        </Button>
    </div>
</form>
