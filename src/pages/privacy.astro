---
import ContentLayout from "../layouts/ContentLayout.astro";
---

<ContentLayout title="Privacy" description="Dopaste is built for low-friction sharing, not identity or tracking.">
    <section>
        <h2>Accounts</h2>
        <p>
            Dopaste does not require accounts to create or read pastes.
        </p>
    </section>
    <section>
        <h2>Content</h2>
        <p>
            Pastes are intended to be shareable by URL. Do not paste secrets, private keys, passwords, or personal data.
        </p>
    </section>
    <section>
        <h2>Operations</h2>
        <p>
            Basic infrastructure logs may be processed by the hosting platform to keep the service secure and reliable.
        </p>
    </section>
</ContentLayout>
