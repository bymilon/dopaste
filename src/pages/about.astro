---
import ContentLayout from "../layouts/ContentLayout.astro";
---

<ContentLayout title="About" description="A small, anonymous place to share rendered Markdown without accounts or ceremony.">
    <section>
        <h2>Purpose</h2>
        <p>
            Dopaste is a minimal pastebin for Markdown notes, snippets, logs, and short documents.
            You write, submit, and get a permanent read-only URL.
        </p>
    </section>
    <section>
        <h2>What It Avoids</h2>
        <ul>
            <li>No accounts or profiles.</li>
            <li>No social feed or engagement loops.</li>
            <li>No rich editor lock-in. Markdown stays portable.</li>
        </ul>
    </section>
</ContentLayout>
