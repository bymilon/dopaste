---
import ContentLayout from "../layouts/ContentLayout.astro";
---

<ContentLayout title="Terms" description="Use Dopaste kindly, legally, and with the assumption that shared URLs can be read by others.">
    <section>
        <h2>Acceptable Use</h2>
        <p>
            Do not use Dopaste to publish malware, harassment, illegal material, spam, or content that infringes others' rights.
        </p>
    </section>
    <section>
        <h2>Availability</h2>
        <p>
            Dopaste is provided as a lightweight service without uptime guarantees.
        </p>
    </section>
    <section>
        <h2>Responsibility</h2>
        <p>
            You are responsible for the content you submit and the URLs you share.
        </p>
    </section>
</ContentLayout>
