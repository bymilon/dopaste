---
import { env } from "cloudflare:workers";
import EditorFooter from "../features/pastes/components/Footer.astro";
import EditorForm from "../features/pastes/components/EditorForm.astro";
import { CreatePasteSchema } from "../features/pastes/model";
import { createPaste } from "../features/pastes/storage";
import "../styles/global.css";

export const prerender = false;

let error = "";
let value = "";
let db: D1Database | undefined;

try {
    db = env.DB;
} catch {
    error = "D1 binding unavailable.";
}

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    value = String(formData.get("paste") ?? "");
    const parsed = CreatePasteSchema.safeParse({ paste: value });

    if (!parsed.success) {
        error = parsed.error.issues[0]?.message ?? "Paste is invalid.";
    } else if (!db) {
        error = "D1 binding unavailable.";
    } else {
        try {
            const paste = await createPaste(db, parsed.data.paste);
            return Astro.redirect(`/p/${paste.id}`, 303);
        } catch (cause) {
            error =
                cause instanceof Error
                    ? cause.message
                    : "Paste could not be created.";
        }
    }
}
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Dopaste</title>
    </head>
    <body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
        <div
            class="mx-auto flex min-h-screen w-full max-w-5xl flex-col px-4 py-6 sm:px-6 lg:px-8"
        >
            <main class="flex flex-1 py-6">
                <EditorForm error={error} value={value} disabled={!db} />
            </main>
            <EditorFooter />
        </div>
    </body>
</html>
