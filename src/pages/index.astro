---
// Import Tailwind v4 global styles
import "../styles/global.css";

import { env } from "cloudflare:workers";
import { z } from "zod";

export const prerender = false;

// 1. Zod Form Validation Constraints
const CreatePasteSchema = z.object({
    title: z
        .string()
        .trim()
        .min(1, "Title is required")
        .max(100, "Title must be 100 characters or less"),
    content: z
        .string()
        .min(1, "Paste content cannot be empty")
        .max(50000, "Paste content must be 50,000 characters or less"),
    language: z
        .enum([
            "plaintext",
            "javascript",
            "typescript",
            "rust",
            "go",
            "python",
            "html",
            "css",
            "json",
            "yaml",
            "markdown",
        ])
        .default("plaintext"),
});

type FormFieldErrors = {
    title?: string[];
    content?: string[];
    language?: string[];
};

let errors: FormFieldErrors = {};
let genericError = "";
let dbStatus: "connected" | "disconnected" = "connected";
let db: D1Database | undefined;

try {
    db = env.DB;
    if (!db) dbStatus = "disconnected";
} catch {
    dbStatus = "disconnected";
}

// 2. POST Submission logic
if (Astro.request.method === "POST" && dbStatus === "connected" && db) {
    try {
        const formData = await Astro.request.formData();
        const payload = {
            title: formData.get("title"),
            content: formData.get("content"),
            language: formData.get("language") || "plaintext",
        };

        const parsedResult = CreatePasteSchema.safeParse(payload);

        if (!parsedResult.success) {
            errors = parsedResult.error.flatten().fieldErrors;
        } else {
            const id = crypto.randomUUID();
            const createdAt = Date.now();

            await db
                .prepare(
                    "INSERT INTO pastes (id, title, content, language, created_at) VALUES (?, ?, ?, ?, ?)",
                )
                .bind(
                    id,
                    parsedResult.data.title,
                    parsedResult.data.content,
                    parsedResult.data.language,
                    createdAt,
                )
                .run();

            return Astro.redirect("/");
        }
    } catch (err: any) {
        genericError =
            err.message || "An error occurred while saving the paste.";
    }
}

// 3. GET Query logic
let pastes: Array<{
    id: string;
    title: string;
    content: string;
    language: string;
    created_at: number;
}> = [];

if (dbStatus === "connected" && db) {
    try {
        const { results } = await db
            .prepare("SELECT * FROM pastes ORDER BY created_at DESC LIMIT 30")
            .all();
        pastes = (results || []) as any;
    } catch (err: any) {
        genericError = "Database Query Error: " + err.message;
    }
}

function formatTime(timestamp: number) {
    return new Date(timestamp).toLocaleString("en-US", {
        month: "short",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
    });
}
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Astro Pastes - Tailwind v4 Edge Console</title>
    </head>
    <body
        class="bg-slate-950 text-slate-100 min-h-screen font-sans antialiased py-8 px-4 sm:px-6 lg:px-8"
    >
        <div class="max-w-6xl mx-auto">
            <!-- Top Bar -->
            <header
                class="flex justify-between items-center mb-8 pb-4 border-b border-slate-800"
            >
                <h1 class="text-xl font-bold tracking-tight sm:text-2xl">
                    Astro Edge Pastes
                </h1>
                <div>
                    {
                        dbStatus === "connected" ? (
                            <span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-3 py-1 rounded-full text-xs font-semibold tracking-wide">
                                D1 Connected
                            </span>
                        ) : (
                            <span class="bg-rose-500/10 text-rose-400 border border-rose-500/20 px-3 py-1 rounded-full text-xs font-semibold tracking-wide">
                                D1 Binding Offline
                            </span>
                        )
                    }
                </div>
            </header>

            {
                genericError && (
                    <div class="bg-rose-500/10 border border-rose-500/30 text-rose-400 p-4 rounded-lg mb-6 text-sm">
                        {genericError}
                    </div>
                )
            }

            <!-- Grid Layout -->
            <main class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <!-- Column 1: Creation Form (5/12 width) -->
                <section
                    class="lg:col-span-5 bg-slate-900 border border-slate-800/80 rounded-xl p-6 shadow-xl h-fit"
                >
                    <h2 class="text-lg font-semibold text-slate-200 mb-5">
                        Create New Paste
                    </h2>

                    <form method="POST" class="space-y-4">
                        <div>
                            <label
                                for="title"
                                class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5"
                            >
                                Paste Title
                            </label>
                            <input
                                type="text"
                                id="title"
                                name="title"
                                placeholder="Database config or log snippet..."
                                required
                                class="w-full bg-slate-950 border border-slate-800 rounded-lg text-slate-100 px-3.5 py-2 text-sm placeholder-slate-600 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500 transition-all"
                            />
                            {
                                errors.title && (
                                    <p class="text-rose-500 text-xs mt-1">
                                        {errors.title[0]}
                                    </p>
                                )
                            }
                        </div>

                        <div>
                            <label
                                for="language"
                                class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5"
                            >
                                Language Mode
                            </label>
                            <select
                                id="language"
                                name="language"
                                class="w-full bg-slate-950 border border-slate-800 rounded-lg text-slate-100 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500 transition-all"
                            >
                                <option value="plaintext">Plaintext</option>
                                <option value="javascript">JavaScript</option>
                                <option value="typescript">TypeScript</option>
                                <option value="rust">Rust</option>
                                <option value="go">Go</option>
                                <option value="python">Python</option>
                                <option value="html">HTML</option>
                                <option value="css">CSS</option>
                                <option value="json">JSON</option>
                                <option value="yaml">YAML</option>
                                <option value="markdown">Markdown</option>
                            </select>
                            {
                                errors.language && (
                                    <p class="text-rose-500 text-xs mt-1">
                                        {errors.language[0]}
                                    </p>
                                )
                            }
                        </div>

                        <div>
                            <label
                                for="content"
                                class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5"
                            >
                                Paste Body
                            </label>
                            <textarea
                                id="content"
                                name="content"
                                rows="10"
                                placeholder="Paste payload code here..."
                                required
                                class="w-full bg-slate-950 border border-slate-800 rounded-lg text-slate-100 px-3.5 py-2 text-sm font-mono placeholder-slate-600 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500 transition-all resize-y"
                            ></textarea>
                            {
                                errors.content && (
                                    <p class="text-rose-500 text-xs mt-1">
                                        {errors.content[0]}
                                    </p>
                                )
                            }
                        </div>

                        <button
                            type="submit"
                            disabled={dbStatus === "disconnected"}
                            class="w-full bg-blue-600 hover:bg-blue-500 active:bg-blue-700 disabled:opacity-50 disabled:pointer-events-none text-white font-semibold rounded-lg px-4 py-2.5 text-sm transition-colors cursor-pointer"
                        >
                            Save Paste to Edge
                        </button>
                    </form>
                </section>

                <!-- Column 2: Paste List (7/12 width) -->
                <section
                    class="lg:col-span-7 bg-slate-900 border border-slate-800/80 rounded-xl p-6 shadow-xl"
                >
                    <h2 class="text-lg font-semibold text-slate-200 mb-5">
                        Recent Pastes
                    </h2>

                    <div class="space-y-6">
                        {
                            pastes.length === 0 ? (
                                <p class="text-slate-500 text-sm italic">
                                    No entries inside the D1 database yet.
                                </p>
                            ) : (
                                pastes.map((paste) => (
                                    <div class="border-b border-slate-800/60 pb-6 last:border-b-0 last:pb-0">
                                        <div class="flex flex-wrap justify-between items-center gap-2 mb-2">
                                            <span class="font-semibold text-slate-200 text-sm sm:text-base">
                                                {paste.title}
                                            </span>
                                            <span class="text-xs text-slate-400 bg-slate-800 px-2 py-0.5 rounded border border-slate-700/50">
                                                {paste.language} &bull;{" "}
                                                {formatTime(paste.created_at)}
                                            </span>
                                        </div>

                                        <div class="relative bg-slate-950 border border-slate-800/80 rounded-lg overflow-hidden mt-3 group">
                                            <button
                                                class="absolute top-2.5 right-2.5 opacity-60 group-hover:opacity-100 bg-slate-900/90 hover:bg-slate-800 border border-slate-800 text-slate-300 text-[11px] px-2.5 py-1 rounded transition-all cursor-pointer"
                                                data-target={paste.id}
                                            >
                                                Copy
                                            </button>
                                            <pre class="p-4 overflow-x-auto text-xs font-mono text-slate-300 leading-relaxed">
                                                <code id={paste.id}>
                                                    {paste.content}
                                                </code>
                                            </pre>
                                        </div>
                                    </div>
                                ))
                            )
                        }
                    </div>
                </section>
            </main>
        </div>

        <!-- Client-side script handling copy interaction -->
        <script>
            const copyButtons = document.querySelectorAll("[data-target]");
            copyButtons.forEach((button) => {
                button.addEventListener("click", async () => {
                    const targetId = button.getAttribute("data-target");
                    if (!targetId) return;

                    const codeBlock = document.getElementById(targetId);
                    if (!codeBlock) return;

                    try {
                        await navigator.clipboard.writeText(
                            codeBlock.textContent || "",
                        );
                        const originalText = button.textContent;
                        button.textContent = "Copied!";
                        button.classList.add(
                            "text-emerald-400",
                            "border-emerald-500/30",
                        );
                        setTimeout(() => {
                            button.textContent = originalText;
                            button.classList.remove(
                                "text-emerald-400",
                                "border-emerald-500/30",
                            );
                        }, 1500);
                    } catch (err) {
                        console.error(
                            "Clipboard copy action encountered an error:",
                            err,
                        );
                    }
                });
            });
        </script>
    </body>
</html>
