---
import ContentLayout from "../layouts/ContentLayout.astro";
---

<ContentLayout title="How It Works" description="Dopaste keeps the flow intentionally short: write Markdown, create a paste, share the URL.">
    <section>
        <h2>Create</h2>
        <p>
            Paste Markdown into the editor and submit it. Dopaste validates the content size before storing it.
        </p>
    </section>
    <section>
        <h2>Read</h2>
        <p>
            Each paste gets a stable URL that renders the Markdown as a read-only page.
        </p>
    </section>
    <section>
        <h2>Limits</h2>
        <p>
            The editor currently accepts Markdown content up to 64 KiB. This keeps pages fast and the service simple.
        </p>
    </section>
</ContentLayout>
