---
import { env } from "cloudflare:workers";
import MarkdownIt from "markdown-it";
import BaseLayout from "../layouts/BaseLayout.astro";
import Surface from "../components/ui/Surface.astro";
import Button from "../components/ui/Button.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import { getPaste } from "../features/pastes/storage";

export const prerender = false;

const id = Astro.params.id;
let paste = null;
let renderedContent = "";
let canonicalUrl = "";

try {
    const db = env.DB;
    if (id) {
        paste = await getPaste(db, id);
        canonicalUrl = `${Astro.url.origin}/${paste.id}`;
    }
} catch {
    // Handle error
}

if (!paste) {
    Astro.response = new Response(null, { status: 404 });
} else {
    const md = new MarkdownIt();
    renderedContent = md.render(paste.paste);
}

const formatDate = (dateString: string) => {
    const date = new Date(dateString);
    return new Intl.DateTimeFormat("en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        timeZoneName: "short",
    }).format(date);
};
---

{paste ? (
    <BaseLayout title={`Dopaste - ${paste.id}`}>
        <Surface
            as="article"
            tone="primary"
            class="paste-shell flex w-full flex-1 flex-col relative"
        >
            <div class="flex w-full flex-col flex-1">
                {/* URL Display & Copy Button */}
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-6">
                    <div class="flex-1 ui-control-shell px-4 py-3 overflow-hidden">
                        <span class="font-mono text-[color:var(--text-secondary)] text-sm truncate">
                            {canonicalUrl}
                        </span>
                    </div>
                    <Button id="copy-link-btn" variant="secondary" class="shrink-0">
                        Copy Link
                    </Button>
                </div>

                <div class="paste-content">
                    <div set:html={renderedContent} />
                </div>
                <time
                    datetime={paste.created_at}
                    class="paste-meta-date"
                >
                    {formatDate(paste.created_at)}
                </time>
            </div>
        </Surface>
        <ButtonLink href="/" variant="primary" aria-label="New paste" class="paste-fab">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
        </ButtonLink>
    </BaseLayout>
) : (
    <BaseLayout title="Paste Not Found">
        <Surface
            as="article"
            tone="primary"
            class="paste-shell flex w-full flex-1 flex-col items-center justify-center"
        >
            <div class="flex flex-col items-center gap-6 text-center">
                <h1 class="text-lg font-bold text-[color:var(--text-primary)]">
                    Paste Not Found
                </h1>
                <p class="ui-body-muted">
                    The paste you're looking for doesn't exist or has been removed.
                </p>
                <ButtonLink href="/" variant="secondary">
                    Go Home
                </ButtonLink>
            </div>
        </Surface>
    </BaseLayout>
)}

<!-- Client-side JS for copy link -->
<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
    const copyBtn = document.getElementById('copy-link-btn');
    const url = window.location.href;
    let ariaLive = null;

    // Create aria-live region if not exists
    function getAriaLive() {
        if (!ariaLive) {
            ariaLive = document.createElement('div');
            ariaLive.setAttribute('aria-live', 'polite');
            ariaLive.style.position = 'absolute';
            ariaLive.style.width = '1px';
            ariaLive.style.height = '1px';
            ariaLive.style.padding = '0';
            ariaLive.style.margin = '-1px';
            ariaLive.style.overflow = 'hidden';
            ariaLive.style.clip = 'rect(0,0,0,0)';
            ariaLive.style.whiteSpace = 'nowrap';
            ariaLive.style.borderWidth = '0';
            document.body.appendChild(ariaLive);
        }
        return ariaLive;
    }

    if (copyBtn) {
        copyBtn.addEventListener('click', async function() {
            try {
                await navigator.clipboard.writeText(url);
                const originalText = copyBtn.textContent;
                copyBtn.textContent = 'Copied!';
                const live = getAriaLive();
                live.textContent = 'Link copied to clipboard';
                setTimeout(() => {
                    copyBtn.textContent = originalText;
                    live.textContent = '';
                }, 2000);
            } catch (error) {
                console.error('Failed to copy link:', error);
                // Fallback: show alert or just leave as is
                const live = getAriaLive();
                live.textContent = 'Failed to copy link';
            }
        });
    }
});
</script>
