---
import EditorFooter from "../features/pastes/components/Footer.astro";
import "../styles/global.css";

type Props = {
    title?: string;
    description?: string;
};

const { title = "Dopaste", description = "Anonymous markdown pastebin." } =
    Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <title>{title}</title>
    </head>
    <body class="min-h-screen antialiased">
        <div
            class="mx-auto flex min-h-screen w-full max-w-6xl flex-col px-3 py-4 sm:px-8 sm:py-8 lg:px-12"
        >
            <main class="flex flex-1 items-start">
                <slot />
            </main>
            <EditorFooter />
        </div>
    </body>
</html>
