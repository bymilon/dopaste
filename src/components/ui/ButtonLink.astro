---
type Props = {
    href: string;
    variant?: "primary" | "secondary" | "ghost" | "destructive";
    target?: string;
    rel?: string;
    class?: string;
};

const {
    href,
    variant = "secondary",
    target,
    rel,
    class: className = "",
} = Astro.props;
---

<a
    href={href}
    target={target}
    rel={rel}
    class:list={["ui-button", `ui-button-${variant}`, className]}
>
    <slot />
</a>
