---
type Props = {
    type?: "button" | "submit" | "reset";
    variant?: "primary" | "secondary" | "ghost" | "destructive";
    disabled?: boolean;
    class?: string;
};

const {
    type = "button",
    variant = "primary",
    disabled = false,
    class: className = "",
} = Astro.props;
---

<button
    type={type}
    disabled={disabled}
    class:list={["ui-button", `ui-button-${variant}`, className]}
>
    <slot />
</button>
